# Database — local dev uses the SQLite file directly; production points at Turso.
DATABASE_URL="file:./dev.db"
TURSO_DATABASE_URL="libsql://your-db-name.turso.io"
TURSO_AUTH_TOKEN="your-auth-token"

# Auth — signs/verifies the session JWT (lib/auth.ts). Required, no default.
JWT_SECRET="a long random string"

# Google Sign-In (components/GoogleSignInButton.tsx, app/api/auth/google/route.ts).
# Same OAuth client ID on both — NEXT_PUBLIC_ is the browser-side copy.
GOOGLE_CLIENT_ID="xxx.apps.googleusercontent.com"
NEXT_PUBLIC_GOOGLE_CLIENT_ID="xxx.apps.googleusercontent.com"

# Image uploads (app/api/upload/route.ts). Without this, local dev falls back
# to writing into public/uploads — required once deployed to Vercel.
BLOB_READ_WRITE_TOKEN=""

# Outgoing mail (lib/mailer.ts) — tried in this order: Resend, then Gmail SMTP,
# then a dev-mode fallback that just logs to the console. Optional locally.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Ropinder <onboarding@resend.dev>"
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
SUPPORT_EMAIL="Soporte.Ropinder@gmail.com"

# Vercel Cron (app/api/cron/monthly-reset/route.ts) — Vercel signs its own
# cron requests automatically; this is only checked for manual/external calls.
CRON_SECRET=""

# Firebase Cloud Messaging — client config is public by design (safe to ship
# to the browser); the three FIREBASE_* server vars are the Admin SDK service
# account and must stay secret.
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_VAPID_KEY=""
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
