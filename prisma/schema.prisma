generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        String  @id @default(cuid())
  name      String  @unique
  fullName  String  @default("")
  email     String  @unique
  password  String
  avatar    String  @default("https://i.pravatar.cc/150?img=70")
  bio       String  @default("")
  phone     String  @default("")
  phoneVerified Boolean @default(false)
  address   String  @default("")
  crossStreets String @default("")
  postalCode   String @default("")
  latitude  Float   @default(-34.46)
  longitude Float   @default(-58.53)
  isPremium Boolean @default(false)
  premiumUntil DateTime?
  premiumPlan  String?
  credits   Int     @default(5)
  balance   Float   @default(0.0)
  role          String  @default("USER")
  bannedAt      DateTime?
  ratingAvg     Float   @default(0)
  ratingCount   Int     @default(0)
  emailVerified Boolean @default(false)
  verified      Boolean @default(false)
  verifiedAt    DateTime?
  // Badge now expires and must be renewed — see lib/auth.ts's expire-on-read
  // check next to the existing premiumUntil one. Null while never verified
  // or while verified via an admin grant that predates this field.
  verifiedUntil DateTime?
  // PERSONAL | STORE — a Store is still a User (same login/session/wallet),
  // just with different credit/badge pricing and its own admin section
  // (see lib/pricing.ts's per-accountType Config keys and /admin/tiendas).
  accountType   String  @default("PERSONAL")
  termsAcceptedAt DateTime?
  // JSON string arrays — style/brand affinities picked during onboarding,
  // used to bias feed ranking (never a hard filter).
  stylePrefs    String   @default("[]")
  brandPrefs    String   @default("[]")
  lastSeenAt    DateTime?
  createdAt     DateTime @default(now())

  clothingItems    ClothingItem[]
  swipes           Swipe[]
  matchesAsA       Match[]       @relation("UserA")
  matchesAsB       Match[]       @relation("UserB")
  messagesSent     Message[]
  transactions     Transaction[]
  reportsMade      Report[]      @relation("ReportsMade")
  reportsReceived  Report[]      @relation("ReportsReceived")
  reportsReviewed  Report[]      @relation("ReportsReviewed")
  ratingsGiven     Rating[]      @relation("RatingsGiven")
  ratingsReceived  Rating[]      @relation("RatingsReceived")
  favorites        Favorite[]
  notifications    Notification[]
  pushTokens       PushToken[]
  offersMade       Offer[]       @relation("OffersMade")
  offersReceived   Offer[]       @relation("OffersReceived")
  questionsAsked   Question[]
  auctionsSelling  Auction[]     @relation("AuctionsSelling")
  auctionsWon      Auction[]     @relation("AuctionsWon")
  bids             Bid[]
  configEdits      Config[]
  auditLogs        AdminAuditLog[]
  savedSearches    SavedSearch[]
}

model ClothingItem {
  id          String   @id @default(cuid())
  title       String
  description String   @default("")
  size        String
  brand       String
  condition   String
  category    String   @default("Ropa")
  style       String   @default("")
  // Cover photo — kept as a plain string so every existing render site
  // (feed, Ropero, admin tables) keeps working untouched. `images` below is
  // the full gallery (imageUrl == images[0]); only the detail page and the
  // publish form read it.
  imageUrl    String
  images      String   @default("[]")
  price       Float?
  // VENTA | INTERCAMBIO | SUBASTA — un canje directo (Offer.offeredItemId)
  // sigue siendo posible sobre cualquier ítem sin importar este campo.
  listingType String   @default("VENTA")
  viewCount   Int      @default(0)
  isBumped    Boolean  @default(false)
  bumpedAt    DateTime?
  isAd        Boolean  @default(false)
  // VIP: paid direct-access listing. Unlocking one (credits, see
  // lib/vip.ts) creates the Match right away instead of requiring the
  // usual mutual-swipe — see ROADMAP "Loop 06" for why.
  isVip       Boolean  @default(false)
  vipAt       DateTime?
  archived    Boolean  @default(false)
  soldAt      DateTime?
  expiresAt   DateTime?
  latitude    Float
  longitude   Float
  userId      String
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])
  swipes      Swipe[]
  reports     Report[]
  favorites   Favorite[]
  offers      Offer[]
  offeredInTrades Offer[]  @relation("TradeOfferedItem")
  questions   Question[]
  auction     Auction?
}

// Server-authoritative: currentPrice/status/winnerId only ever change inside
// /api/auctions routes, never trusted from the client. See bid route for the
// concurrency-safe accept-highest-bid pattern.
model Auction {
  id            String    @id @default(cuid())
  itemId        String    @unique
  sellerId      String
  startingPrice Float
  minIncrement  Float
  currentPrice  Float
  startsAt      DateTime  @default(now())
  endsAt        DateTime
  status        String    @default("ACTIVE") // SCHEDULED | ACTIVE | ENDED | CANCELLED
  winnerId      String?
  createdAt     DateTime  @default(now())

  item   ClothingItem @relation(fields: [itemId], references: [id])
  seller User         @relation("AuctionsSelling", fields: [sellerId], references: [id])
  winner User?        @relation("AuctionsWon", fields: [winnerId], references: [id])
  bids   Bid[]

  @@index([status, endsAt])
}

model Bid {
  id        String   @id @default(cuid())
  auctionId String
  bidderId  String
  amount    Float
  createdAt DateTime @default(now())

  auction Auction @relation(fields: [auctionId], references: [id])
  bidder  User    @relation(fields: [bidderId], references: [id])

  @@index([auctionId, amount])
}

model Swipe {
  id           String       @id @default(cuid())
  swiperId     String
  targetItemId String
  type         String
  createdAt    DateTime     @default(now())
  swiper       User         @relation(fields: [swiperId], references: [id])
  targetItem   ClothingItem @relation(fields: [targetItemId], references: [id])

  @@unique([swiperId, targetItemId])
}

model Match {
  id        String    @id @default(cuid())
  userAId   String
  userBId   String
  createdAt DateTime  @default(now())
  userA     User      @relation("UserA", fields: [userAId], references: [id])
  userB     User      @relation("UserB", fields: [userBId], references: [id])
  messages  Message[]
  reports   Report[]
  ratings   Rating[]
  offers    Offer[]
}

model Message {
  id         String   @id @default(cuid())
  matchId    String
  senderId   String
  text       String
  // FREE (typed) | GUIDED (picked from the admin-editable question bank,
  // see ChatQuestion/ChatAnswer below). Guided messages carry questionId/
  // answerId so the exact bank entry used is traceable even if the bank
  // text is edited later — see ROPINDER_BIBLE/LOOPS/04-CHAT-ENGINE.md
  // ("changes must not destroy historical conversations").
  kind       String   @default("FREE")
  questionId String?
  answerId   String?
  createdAt  DateTime @default(now())

  match    Match         @relation(fields: [matchId], references: [id])
  sender   User          @relation(fields: [senderId], references: [id])
  question ChatQuestion? @relation(fields: [questionId], references: [id])
  answer   ChatAnswer?   @relation(fields: [answerId], references: [id])
}

// Admin-editable guided-chat question bank (Loop 04 — Chat Engine). Rendered
// as tap-to-send quick replies in the chat, before free text; unlike free
// text it never needs contact-info moderation (lib/chatFilter.ts) since the
// content is pre-vetted by an admin, not typed by a user.
model ChatCategory {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  questions ChatQuestion[]
}

model ChatQuestion {
  id         String   @id @default(cuid())
  categoryId String
  text       String
  order      Int      @default(0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  category ChatCategory @relation(fields: [categoryId], references: [id])
  answers  ChatAnswer[]
  messages Message[]
}

model ChatAnswer {
  id         String  @id @default(cuid())
  questionId String
  text       String
  order      Int     @default(0)
  active     Boolean @default(true)

  question ChatQuestion @relation(fields: [questionId], references: [id])
  messages Message[]
}

model Transaction {
  id          String    @id @default(cuid())
  userId      String
  amount      Float
  type        String
  status      String    @default("PENDING")
  meta        String    @default("{}")
  availableAt DateTime?
  withdrawnAt DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id])
}

model Report {
  id             String    @id @default(cuid())
  reporterId     String
  reportedUserId String?
  itemId         String?
  matchId        String?
  reason         String
  details        String    @default("")
  status         String    @default("PENDING")
  resolution     String    @default("")
  reviewedById   String?
  createdAt      DateTime  @default(now())
  reviewedAt     DateTime?

  reporter     User          @relation("ReportsMade", fields: [reporterId], references: [id])
  reportedUser User?         @relation("ReportsReceived", fields: [reportedUserId], references: [id])
  reviewedBy   User?         @relation("ReportsReviewed", fields: [reviewedById], references: [id])
  item         ClothingItem? @relation(fields: [itemId], references: [id])
  match        Match?        @relation(fields: [matchId], references: [id])
}

model Rating {
  id            String   @id @default(cuid())
  matchId       String
  raterId       String
  ratedUserId   String
  score         Int
  comment       String   @default("")
  createdAt     DateTime @default(now())

  match     Match @relation(fields: [matchId], references: [id])
  rater     User  @relation("RatingsGiven", fields: [raterId], references: [id])
  ratedUser User  @relation("RatingsReceived", fields: [ratedUserId], references: [id])

  @@unique([matchId, raterId])
}

model VerificationCode {
  id        String   @id @default(cuid())
  email     String
  code      String
  purpose   String   @default("SIGNUP")
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email, purpose])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  itemId    String
  createdAt DateTime @default(now())

  user User         @relation(fields: [userId], references: [id])
  item ClothingItem @relation(fields: [itemId], references: [id])

  @@unique([userId, itemId])
}

// A standing filter a user wants to be notified about — query is a JSON
// blob (category/size/brand/priceMax/etc.), matched against new listings by
// a lib/savedSearch.ts helper, not by the DB (Turso/libSQL has no JSON
// query operators worth relying on here, and the match set is small).
model SavedSearch {
  id        String   @id @default(cuid())
  userId    String
  query     String   @default("{}")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String    @default("")
  link      String    @default("")
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])
}

model PushToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  platform  String   @default("web")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model BlockedEmail {
  id        String   @id @default(cuid())
  email     String   @unique
  reason    String   @default("")
  blockedBy String   @default("")
  createdAt DateTime @default(now())
}

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ip        String   @default("")
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
}

// A buyer-proposed price on a specific listing, inside an existing match —
// OR a barter proposal (offeredItemId set, amount 0) trading one of the
// buyer's own items for the seller's. Only an ACCEPTED money offer's amount
// may ever be paid — /api/matches/[id]/pay still refuses any client-supplied
// amount for a priced item. A barter has no money to escrow, so an accepted
// trade is closed out via completedAt instead (see /offers/[offerId]).
model Offer {
  id            String    @id @default(cuid())
  matchId       String
  itemId        String
  buyerId       String
  sellerId      String
  amount        Float     @default(0)
  offeredItemId String?
  status        String    @default("PENDING") // PENDING | ACCEPTED | REJECTED | CANCELLED
  createdAt     DateTime  @default(now())
  respondedAt   DateTime?
  completedAt   DateTime?

  match       Match        @relation(fields: [matchId], references: [id])
  item        ClothingItem @relation(fields: [itemId], references: [id])
  buyer       User         @relation("OffersMade", fields: [buyerId], references: [id])
  seller      User         @relation("OffersReceived", fields: [sellerId], references: [id])
  offeredItem ClothingItem? @relation("TradeOfferedItem", fields: [offeredItemId], references: [id])

  @@index([itemId, buyerId])
}

// Public Q&A on a listing — visible to anyone browsing, not just the asker,
// same pattern as most resale marketplaces (reduces repeat DMs).
model Question {
  id         String    @id @default(cuid())
  itemId     String
  askerId    String
  text       String
  answer     String?
  answeredAt DateTime?
  createdAt  DateTime  @default(now())

  item  ClothingItem @relation(fields: [itemId], references: [id])
  asker User         @relation(fields: [askerId], references: [id])

  @@index([itemId, createdAt])
}

// Generic admin-editable settings (commission rates, withdrawal fee, ...) —
// replaces hardcoded constants for anything the business needs to tune
// without a redeploy. Reading a missing key falls back to the same default
// the constant used to have (see lib/config.ts), so this is safe to adopt
// key by key instead of needing every value seeded up front.
model Config {
  key         String   @id
  value       String
  updatedById String?
  updatedAt   DateTime @updatedAt

  updatedBy User? @relation(fields: [updatedById], references: [id])
}

// Audit trail of sensitive admin actions (Loop 03 — ADMIN §"Audit Logs").
// Append-only by convention (no update/delete route ever touches this
// table) — same "never mutate history" rule the financial ledger follows.
// Only the highest-impact actions log here (ban/delete a user, grant
// premium/credits, promote/demote admin, edit commissions, block an
// email) — logging every read or minor toggle would bury what matters.
model AdminAuditLog {
  id         String   @id @default(cuid())
  adminId    String
  action     String
  targetType String
  targetId   String?
  meta       String   @default("{}")
  createdAt  DateTime @default(now())

  admin User @relation(fields: [adminId], references: [id])

  @@index([createdAt])
  @@index([adminId, createdAt])
}
